   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x500 with 4 Axes>"
      ]
     },
     "execution_count": 3,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# Create the initial figure\n",
    "fig, axes = plt.subplots(1, 2, figsize=(8, 5))\n",
    "draw_perf(fig, axes, prior, tpr, fpr)\n",
    "txt = \"To select a performance, click or drag the blue point in the ROC space.\"\n",
    "fig.suptitle( txt, fontweight=\"bold\", fontstyle='italic' )\n",
    "fig.tight_layout(pad=1.5)\n",
    "axslide = fig.add_axes([0.1, 0.05, 0.8, 0.03])\n",
    "slider = Slider(\n",
    "    ax=axslide,\n",
    "    label=r'$\\pi_+ = P(Y=c_+)$',\n",
    "    valmin=0.0,\n",
    "    valmax=1.0,\n",
    "    valinit=prior,\n",
    "    valstep=0.01,\n",
    "    orientation='horizontal'\n",
    ")\n",
    "fig.subplots_adjust(bottom=0.2)\n",
    "\n",
    "def redraw_all_now () :\n",
    "    try :\n",
    "        axes[1].images[-1].colorbar.remove()\n",
    "    except :\n",
    "        pass\n",
    "    for ax in axes:\n",
    "        ax.clear()\n",
    "    draw_perf(fig, axes, prior, tpr, fpr)\n",
    "    fig.canvas.draw_idle() # or plt.show() ?\n",
    "\n",
    "def update_motion_notify(event):\n",
    "    if event.inaxes != axes[0]:\n",
    "        return\n",
    "    if event.button is None :\n",
    "        return # This is not a drag and drop\n",
    "    global fpr, tpr\n",
    "    fpr, tpr = event.xdata, event.ydata\n",
    "    redraw_all_now ()\n",
    "\n",
    "plt.connect(\"motion_notify_event\", update_motion_notify)\n",
    "\n",
    "# Update when clicking the Tile\n",
    "def update_click(event):\n",
    "    if event.inaxes != axes[0]:\n",
    "        return\n",
    "    elif event.button is MouseButton.LEFT:\n",
    "        global fpr, tpr\n",
    "        fpr, tpr = event.xdata, event.ydata\n",
    "    redraw_all_now ()\n",
    "\n",
    "plt.connect(\"button_press_event\", update_click)\n",
    "\n",
    "# Update when moving the prior slider\n",
    "def update_slider(val):\n",
    "    \n",
    "    if val < 0.01 :\n",
    "        val = 0.01\n",
    "        slider.set_val ( val )\n",
    "    if val > 0.99 :\n",
    "        val = 0.99\n",
    "        slider.set_val ( val )\n",
    "        \n",
    "    global prior\n",
    "    prior = val\n",
    "    redraw_all_now ()\n",
    "\n",
    "slider.on_changed(update_slider)\n",
    "\n",
    "plt.show()\n",
    "fig"
   ]
  }
